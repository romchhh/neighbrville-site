# Public site URL (used in emails, sitemap, canonical, OG)
NEXT_PUBLIC_SITE_URL=https://neighbrville.com

# Admin panel (/admin) — REQUIRED (password min 12 chars in production)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-to-a-long-secret
# Optional: separate signing secret for session cookies (defaults to ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=

# Resend (https://resend.com) — also editable in Admin → Settings
RESEND_API_KEY=
RESEND_FROM=NeighbrVille <info@neighbrville.com>

# Optional: SQLite file path (default: ./data/neighbrville.db)
# DATABASE_PATH=./data/neighbrville.db
